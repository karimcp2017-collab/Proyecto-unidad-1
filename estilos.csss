body {
  font-family: Arial, sans-serif;
  background-color: #f4f4f4;
  margin: 0;
  padding: 0;
}

.contenedor {
  max-width: 900px;
  margin: 60px auto;
  padding: 40px;
  background-color: #fff;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 0 15px rgba(0,0,0,0.1);
}

h2, h3 {
  color: #007bff;
  margin-bottom: 20px;
}

p {
  color: #333;
  line-height: 1.6;
  margin-bottom: 25px;
}

button {
  background-color: #007bff;
  color: white;
  border: none;
  padding: 10px 20px;
  margin: 10px;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background-color: #0056b3;
}

input {
  margin: 5px;
  padding: 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
}

#resultado {
  margin-top: 20px;
  background-color: #e9ecef;
  padding: 10px;
  border-radius: 5px;
  text-align: left;
}

.tabla-alfabeto {
  margin: 20px auto;
  border-collapse: collapse;
  width: 95%;
}

.tabla-alfabeto th, .tabla-alfabeto td {
  border: 1px solid #000;
  padding: 8px;
  text-align: center;
}

.tabla-alfabeto th {
  background-color: #007bff;
  color: white;
}
